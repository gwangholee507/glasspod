{
  "name": "glasspod",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "engines": {
    "node": "22.22.0"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean && rm -rf packages/*/dist apps/*/dist examples/*/dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "npm run generate -w @glasspod/protocol",
    "dev:server": "npm run dev -w @glasspod/server",
    "dev:web": "npm run dev -w @glasspod/web",
    "build:web": "npm run build -w @glasspod/web",
    "demo": "npm run start -w @glasspod/demo-app",
    "demo:load": "npm run load -w @glasspod/demo-app"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
