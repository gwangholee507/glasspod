{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SdkMessage",
  "description": "SDK가 서버로 보내는 메시지입니다(design.md 7.3). type 값으로 종류를 나눕니다.",
  "type": "object",
  "required": ["type"],
  "discriminator": { "propertyName": "type" },
  "oneOf": [
    { "$ref": "#/definitions/Hello" },
    { "$ref": "#/definitions/Metrics" },
    { "$ref": "#/definitions/Event" },
    { "$ref": "#/definitions/Response" }
  ],
  "definitions": {
    "Seq": {
      "title": "Seq",
      "description": "프로세스가 시작될 때 0부터 셉니다. SDK가 실제로 보낼 때 붙이므로 보낸 순서대로 늘어나고, 재연결해도 이어집니다. SDK는 보낸 메시지를 다시 보내지 않으므로 서버는 빈틈으로 누락을 알 수 있습니다.",
      "type": "integer",
      "minimum": 0
    },
    "Timestamp": {
      "title": "Timestamp",
      "description": "보낸 시각(epoch ms)입니다. event만은 일어난 시각입니다(묶어 보낸 event는 그 묶음에서 처음 일어난 것, 연결이 없는 동안 들고 있다가 보낸 event도 원래 시각). 서버는 받은 시각을 따로 기록합니다.",
      "type": "integer",
      "minimum": 0
    },
    "PodRef": {
      "title": "PodRef",
      "description": "Pod를 가리키는 키입니다. SDK는 Downward API로 받은 환경변수에서 읽습니다.",
      "type": "object",
      "required": ["namespace", "name"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "Hello": {
      "title": "HelloMessage",
      "description": "연결 직후 한 번 보냅니다. 나는 누구인가(Pod, 인스턴스)를 알립니다.",
      "type": "object",
      "required": ["type", "seq", "ts", "protocol", "sdk", "pod", "instanceId"],
      "properties": {
        "type": { "const": "hello" },
        "seq": { "$ref": "#/definitions/Seq" },
        "ts": { "$ref": "#/definitions/Timestamp" },
        "protocol": {
          "description": "프로토콜 버전입니다. 필드를 없애거나 의미를 바꿀 때만 올립니다.",
          "type": "integer",
          "minimum": 1
        },
        "sdk": {
          "type": "object",
          "required": ["lang", "version"],
          "properties": {
            "lang": {
              "description": "SDK 언어입니다. 예: node",
              "type": "string",
              "minLength": 1
            },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "pod": { "$ref": "#/definitions/PodRef" },
        "instanceId": {
          "description": "SDK가 시작할 때 무작위로 만듭니다. Pod 이름은 같은데 instanceId가 바뀌었으면 컨테이너가 재시작된 것입니다.",
          "type": "string",
          "minLength": 1
        },
        "app": {
          "description": "감시 대상 앱의 이름과 버전입니다.",
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string" }
          }
        },
        "capabilities": {
          "description": "이 SDK가 응답할 수 있는 요청(request의 action) 목록입니다. 예: snapshot",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "MetricName": {
      "title": "MetricName",
      "description": "지표 이름입니다. 소문자, 숫자, _로 쓰고 단계는 .으로 나눕니다. 접두어로 출처를 구분합니다(runtime.*, http.*은 SDK 자동 수집, app.*은 개발자 등록).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "MetricKind": {
      "title": "MetricKind",
      "description": "gauge는 지금 값, counter는 누적값입니다. counter 값이 줄어들면 서버는 프로세스가 재시작됐다고 판단합니다.",
      "enum": ["gauge", "counter"]
    },
    "MetricValue": {
      "title": "MetricValue",
      "type": "object",
      "required": ["name", "kind", "value"],
      "properties": {
        "name": { "$ref": "#/definitions/MetricName" },
        "kind": { "$ref": "#/definitions/MetricKind" },
        "value": { "type": "number" }
      }
    },
    "Metrics": {
      "title": "MetricsMessage",
      "description": "정해진 주기마다 보냅니다. 보낼 값이 없어도 빈 묶음을 보내며, 이것이 heartbeat입니다.",
      "type": "object",
      "required": ["type", "seq", "ts", "values"],
      "properties": {
        "type": { "const": "metrics" },
        "seq": { "$ref": "#/definitions/Seq" },
        "ts": { "$ref": "#/definitions/Timestamp" },
        "values": {
          "type": "array",
          "items": { "$ref": "#/definitions/MetricValue" }
        }
      }
    },
    "EventLevel": {
      "title": "EventLevel",
      "enum": ["info", "warn", "error"]
    },
    "Event": {
      "title": "EventMessage",
      "description": "일어나자마자 보냅니다. 같은 이벤트가 쏟아지면 SDK가 묶어서 count로 보냅니다.",
      "type": "object",
      "required": ["type", "seq", "ts", "level", "name", "count"],
      "properties": {
        "type": { "const": "event" },
        "seq": { "$ref": "#/definitions/Seq" },
        "ts": { "$ref": "#/definitions/Timestamp" },
        "level": { "$ref": "#/definitions/EventLevel" },
        "name": {
          "description": "exception(예외), state(상태 전환), 그 밖에 개발자가 정의한 이벤트 이름입니다.",
          "type": "string",
          "minLength": 1
        },
        "message": { "type": "string" },
        "count": {
          "description": "묶어서 보낸 횟수입니다. 한 건이면 1입니다.",
          "type": "integer",
          "minimum": 1
        },
        "data": {
          "description": "이벤트별 추가 정보입니다. 예: errorType, route, stack",
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Response": {
      "title": "ResponseMessage",
      "description": "서버의 request에 대한 답입니다. 실패하면 ok를 false로 두고 error에 이유를 적습니다.",
      "type": "object",
      "required": ["type", "seq", "ts", "replyTo", "ok"],
      "properties": {
        "type": { "const": "response" },
        "seq": { "$ref": "#/definitions/Seq" },
        "ts": { "$ref": "#/definitions/Timestamp" },
        "replyTo": {
          "description": "답하는 request의 id입니다.",
          "type": "string",
          "minLength": 1
        },
        "ok": { "type": "boolean" },
        "data": {
          "description": "성공했을 때의 결과입니다. 모양은 request의 action에 따라 다릅니다(snapshot은 snapshot.schema.json).",
          "type": "object",
          "additionalProperties": true
        },
        "error": {
          "description": "실패한 이유입니다.",
          "type": "string",
          "minLength": 1
        }
      },
      "if": { "properties": { "ok": { "const": false } } },
      "then": { "required": ["error"] }
    }
  }
}
